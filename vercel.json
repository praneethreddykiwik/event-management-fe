{
  "build": {
    "env": {
      "VITE_API_BASE_URL": "https://helm-events-api.vercel.app"
    }
  },
  "rewrites": [
    {
      "source": "/helm-events-api.vercel.app/:path*",
      "destination": "https://helm-events-api.vercel.app/:path*"
    },
    {
      "source": "/:seg/helm-events-api.vercel.app/:path*",
      "destination": "https://helm-events-api.vercel.app/:path*"
    },
    {
      "source": "/:seg1/:seg2/helm-events-api.vercel.app/:path*",
      "destination": "https://helm-events-api.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
